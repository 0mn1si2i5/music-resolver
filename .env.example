# Music resolver configuration. Copy to .env and fill in values.

# Bind to loopback when the caller runs on the same host.
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8788

# Browser origins allowed to call the API (comma-separated). Leave empty for server-to-server use.
CORS_ORIGINS=

# Spotify API credentials — https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Apple Music storefront region
APPLE_MUSIC_STOREFRONT=cn

# NetEase Cloud Music API base URL (docker-compose overrides this to http://netease:3000)
NETEASE_API_BASE_URL=http://127.0.0.1:3000
NETEASE_REQUEST_TIMEOUT=10

# Optional Songlink API key, not required for the main resolver path.
SONGLINK_API_KEY=

# Enables uvicorn auto-reload when running via python -m app.main.
DEBUG=false
